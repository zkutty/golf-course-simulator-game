{
  "name": "simgolf-lite",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-sw-assets.mjs",
    "lint": "eslint . && npm run lint:i18n",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:release:browsers": "playwright test --config playwright.release.config.ts",
    "release:audit": "node scripts/release-audit.mjs",
    "test:fuzz": "vitest run src/core/reducer.fuzz.test.ts",
    "test:soak": "vite build --ssr src/game/testing/soakCli.ts --outDir soak-dist --emptyOutDir --minify false && node --expose-gc soak-dist/soakCli.js",
    "test:balance": "vite build --ssr src/game/testing/releaseBalanceCli.ts --outDir balance-dist --emptyOutDir --minify false && node balance-dist/releaseBalanceCli.js",
    "tune": "vite build --ssr src/game/tuning/tuneCli.ts --outDir tune-dist --emptyOutDir --minify false && node tune-dist/tuneCli.js",
    "gen:sprites": "node scripts/gen-placeholder-sprites.mjs && node scripts/gen-terrain-materials.mjs && node scripts/process-biome-props.mjs && node scripts/gen-golfer-sprites.mjs",
    "gen:props": "node scripts/process-biome-props.mjs",
    "gen:terrain": "node scripts/gen-terrain-materials.mjs",
    "gen:audio": "node scripts/gen-audio.mjs",
    "gen:m22-art": "node scripts/process-m22-assets.mjs",
    "build:atlas": "node scripts/build-atlas.mjs",
    "test:perf": "node scripts/perf-smoke.mjs",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@sentry/react": "^10.67.0",
    "pixi.js": "^8.14.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}
