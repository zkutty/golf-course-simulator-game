{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "evidence", "regressionTest", "targetedTests"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "needs-repro", "needs-human-review"]
    },
    "summary": {
      "type": "string",
      "maxLength": 3000
    },
    "evidence": {
      "type": "string",
      "maxLength": 5000
    },
    "regressionTest": {
      "type": "string",
      "maxLength": 500
    },
    "targetedTests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "branch": {
      "type": "string",
      "maxLength": 200
    }
  }
}
