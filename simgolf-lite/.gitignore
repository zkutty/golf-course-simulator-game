# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
desktop-dist/
soak-dist/
test-results/
*.local
.env*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# AI-assisted art is generated into an isolated, review-only workspace.
# Only manifests, prompts, benchmarks, and approved production assets belong
# in Git; raw/candidate/cleaned files may contain provider metadata.
art/pixellab/staging/**
!art/pixellab/staging/.gitkeep

# ZK-472's deterministic 4x source is review-only. The generator may recreate
# it locally for an audit, but it must never enter the runtime asset tree.
art/parkland-4x-fallback/**
!art/parkland-4x-fallback/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Audio files
public/audio/*.mp3
public/audio/*.m4a
public/audio/*.wav
public/audio/*.ogg
public/audio/*.aac
public/audio/*.flac
art/audio/legacy-untracked/*
!art/audio/legacy-untracked/README.md
