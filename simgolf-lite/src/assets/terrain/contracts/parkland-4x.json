{
  "version": 3,
  "id": "parkland-terrain-4x",
  "theme": "parkland",
  "source": {
    "root": "src/assets/terrain/parkland-4x",
    "manifest": "manifest.json",
    "kind": "deterministic-coursecraft-production-source",
    "authoredBy": "CourseCraft",
    "generator": "scripts/gen-parkland-4x-fallback.mjs",
    "algorithm": "scripts/gen-terrain-materials.mjs",
    "externalProvider": "none",
    "referencePixelsCopied": false,
    "reviewStatus": "production-contract-adopted",
    "contactSheet": "evidence/contact-sheet.png"
  },
  "determinism": {
    "hashAlgorithm": "sha256",
    "manifestVersion": 2,
    "requiresRepeatableGeneration": true,
    "runtimeAdoption": "production-default",
    "buildManifestField": "assetContracts.parklandTerrain"
  },
  "frame": {
    "width": 256,
    "height": 128,
    "presentationScale": 4,
    "tileSpan": 4,
    "format": "RGBA8888",
    "naming": "parkland_{terrain}_{base|edge|outer|inner}_{variant-or-direction}.png",
    "baseVariants": 6,
    "edgeDirections": ["n", "e", "s", "w"],
    "cornerDirections": ["ne", "se", "sw", "nw"],
    "transparentCorners": true,
    "visiblePixels": true,
    "allowPartialAlpha": true
  },
  "artDirection": {
    "lightDirection": "north-west",
    "pixelClusterPx": { "minimum": 2, "maximum": 6 },
    "paletteRule": "bounded material hierarchy with fixed luminance separation",
    "alphaFringe": "premultiplied-alpha box mip; transparent RGB is zero",
    "anchor": "isometric diamond center; logical footprint 64x32",
    "bleed": "2px transparent atlas gutter",
    "mipRule": "high=native 4x; medium=2x premultiplied box; low=4x premultiplied box",
    "naming": "parkland_{terrain}_{base|edge|outer|inner}_{variant-or-direction}.png",
    "topologyOwner": "src/game/render/materialFields.ts"
  },
  "coverage": {
    "materials": [
      "fairway", "tee", "green", "rough", "deep_rough",
      "waste_area", "path", "wetland", "water", "sand"
    ],
    "edgeDirections": ["n", "e", "s", "w"],
    "contourDirections": ["ne", "se", "sw", "nw"],
    "rendererOwned": {
      "contours": {
        "file": "src/game/render/materialFields.ts",
        "exports": ["contourProfileFor", "allTerrainAdjacencies"],
        "minimumDepthBands": 3
      },
      "slopes": {
        "file": "src/game/render/landscapeGeometry.ts",
        "exports": ["buildVisualHeightfield", "sampleLandscapeSurfaceHeight"]
      },
      "habitats": {
        "file": "src/game/render/treeHabitat.ts",
        "exports": ["treeHabitatKind", "deriveTreeHabitat"],
        "kinds": ["pine_straw", "leaf_litter", "dry_soil"]
      }
    }
  },
  "variants": {
    "quality": {
      "high": { "lod": "detail", "terrainFrames": 180, "frameWidth": 256, "frameHeight": 128, "atlasScale": 4, "mipDivisor": 1, "detailFrames": 22, "fields": 10 },
      "medium": { "lod": "normal", "terrainFrames": 180, "frameWidth": 128, "frameHeight": 64, "atlasScale": 2, "mipDivisor": 2, "detailFrames": 11, "fields": 10 },
      "low": { "lod": "overview", "terrainFrames": 180, "frameWidth": 64, "frameHeight": 32, "atlasScale": 1, "mipDivisor": 4, "detailFrames": 0, "fields": 0 }
    },
    "accessibility": {
      "file": "src/accessibility/terrainPalettes.ts",
      "modes": ["standard", "deuteranopia", "protanopia", "tritanopia"],
      "nonColorPatterns": true
    }
  },
  "offline": {
    "atlasLoader": {
      "file": "src/render/atlas.ts",
      "requiredTokens": ["bundlePromises.delete(key)", "getTerrainFrame", "safe material fallback"]
    },
    "serviceWorker": {
      "file": "public/sw.js",
      "requiredTokens": ["relativePath.startsWith(\"atlases/\")", "await cache.put(event.request, response.clone())"]
    }
  },
  "atlas": {
    "gutterPx": 2,
    "maxWidth": 2048,
    "maxHeight": 4096,
    "name": "terrain-parkland",
    "manifestVersion": 3,
    "contentHashed": true,
    "compression": "PNG DEFLATE level 9, strategy 0; lossless decoded pixels"
  },
  "fallback": {
    "root": "src/assets/terrain/materials",
    "width": 128,
    "height": 64,
    "presentationScale": 2,
    "generator": "scripts/gen-terrain-materials.mjs",
    "runtimeAsset": true,
    "mode": "legacy-2x",
    "environment": "COURSECRAFT_PARKLAND_TERRAIN_MODE=legacy-2x",
    "default": false
  },
  "budgets": {
    "sourceBytesMax": 4194304,
    "atlasBytesMax": 6291456,
    "selectedTransferBytesMax": 6291456,
    "criticalTransferBytesMax": 8388608
  }
}
