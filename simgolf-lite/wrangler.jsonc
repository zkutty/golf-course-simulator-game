{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coursecraft-playtest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUG_REPORT_COORDINATOR",
        "class_name": "BugReportCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "m45-v1",
      "new_sqlite_classes": [
        "BugReportCoordinator"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "BUG_REPORT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "vars": {
    "BUG_REPORTING_ENABLED": "false",
    "SENTRY_ROUTING_ENABLED": "false",
    "SENTRY_MIN_OCCURRENCES": "3",
    "LINEAR_TEAM_ID": "7abe7bd3-d61f-4358-9ee5-071765d3f379",
    "LINEAR_PROJECT_ID": "cd09f00a-5774-4874-8baa-d968f1067ad9",
    "LINEAR_BUG_LABEL_IDS": "d1cb9894-4a96-4f05-893f-1ea74b63acda,c0fc2566-fa7e-4876-a052-b2ae8770e7fd"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "coursecraft-dev",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/api/*"
        ],
        "not_found_handling": "single-page-application"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BUG_REPORT_COORDINATOR",
            "class_name": "BugReportCoordinator"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "BUG_REPORT_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 12,
            "period": 60
          }
        }
      ],
      "vars": {
        "BUG_REPORTING_ENABLED": "true",
        "SENTRY_ROUTING_ENABLED": "true",
        "SENTRY_MIN_OCCURRENCES": "3",
        "LINEAR_TEAM_ID": "7abe7bd3-d61f-4358-9ee5-071765d3f379",
        "LINEAR_PROJECT_ID": "cd09f00a-5774-4874-8baa-d968f1067ad9",
        "LINEAR_BUG_LABEL_IDS": "d1cb9894-4a96-4f05-893f-1ea74b63acda,c0fc2566-fa7e-4876-a052-b2ae8770e7fd"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
