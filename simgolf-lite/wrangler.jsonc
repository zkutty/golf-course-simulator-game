{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coursecraft-playtest",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
